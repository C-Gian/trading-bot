{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"}}},
    "fileWithUrl": {"type": "object", "additionalProperties": false, "required": ["path", "url", "sha256"], "properties": {"path": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "sha256": {"$ref": "#/$defs/hash"}}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}}}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_id", "dataset_version", "source", "symbol", "market_type", "canonical_resolution", "coverage", "row_counts", "files", "content_hash", "schema_version", "integrity", "derivation", "code_reference"],
  "properties": {
    "manifest_id": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "integer", "minimum": 1},
    "schema_version": {"type": "integer", "minimum": 1},
    "source": {"type": "object", "additionalProperties": false, "required": ["provider", "archive_base", "raw_objects"], "properties": {"provider": {"const": "Binance"}, "archive_base": {"type": "string", "format": "uri"}, "raw_objects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fileWithUrl"}}}},
    "symbol": {"const": "BTCUSDT"},
    "market_type": {"const": "spot"},
    "canonical_resolution": {"const": "1m"},
    "coverage": {"$ref": "#/$defs/coverage"},
    "row_counts": {"type": "object", "additionalProperties": false, "required": ["1m", "1h", "4h"], "properties": {"1m": {"type": "integer", "minimum": 1}, "1h": {"type": "integer", "minimum": 1}, "4h": {"type": "integer", "minimum": 1}}},
    "files": {"type": "object", "additionalProperties": false, "required": ["canonical", "1h", "4h"], "properties": {"canonical": {"$ref": "#/$defs/file"}, "1h": {"$ref": "#/$defs/file"}, "4h": {"$ref": "#/$defs/file"}}},
    "content_hash": {"type": "object", "additionalProperties": false, "required": ["algorithm", "value"], "properties": {"algorithm": {"const": "sha256-canonical-csv-v1"}, "value": {"$ref": "#/$defs/hash"}}},
    "integrity": {"type": "object", "additionalProperties": false, "required": ["duplicates", "missing_minutes", "invalid_ohlcv", "incomplete_windows"], "properties": {"duplicates": {"type": "integer", "minimum": 0}, "missing_minutes": {"type": "integer", "minimum": 0}, "invalid_ohlcv": {"type": "integer", "minimum": 0}, "incomplete_windows": {"type": "object", "additionalProperties": false, "required": ["1h", "4h"], "properties": {"1h": {"type": "integer", "minimum": 0}, "4h": {"type": "integer", "minimum": 0}}}}},
    "derivation": {"type": "object", "additionalProperties": false, "required": ["1h", "4h"], "properties": {"1h": {"type": "string"}, "4h": {"type": "string"}}},
    "code_reference": {"type": "string", "minLength": 1}
  }
}
