{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEALED_EVALUATION_V1 result",
  "type": "object",
  "additionalProperties": false,
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
  "required": [
    "schema_version", "version", "query_id", "scope", "candidate_experiment_id",
    "candidate_experiment_version", "request_hash", "executable_spec_hash", "dependency_hash",
    "sealed_dataset_id", "sealed_content_hash", "status", "primary_metric", "primary_result",
    "secondary_results", "robustness_profiles", "consumed_query_index", "finalized_at_utc",
    "evidence_stage", "interpretation", "result_hash"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "version": {"const": "SEALED_EVALUATION_V1"},
    "query_id": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "candidate_experiment_id": {"type": "string", "minLength": 1},
    "candidate_experiment_version": {"type": "integer", "minimum": 1},
    "request_hash": {"$ref": "#/$defs/sha256"},
    "executable_spec_hash": {"$ref": "#/$defs/sha256"},
    "dependency_hash": {"$ref": "#/$defs/sha256"},
    "sealed_dataset_id": {"type": "string", "minLength": 1},
    "sealed_content_hash": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["COMPLETED", "EXECUTION_FAILED"]},
    "primary_metric": {"type": "string", "minLength": 1},
    "primary_result": {"type": ["number", "null"]},
    "secondary_results": {"type": "object"},
    "robustness_profiles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "consumed_query_index": {"type": "integer", "minimum": 1},
    "finalized_at_utc": {"type": "string", "format": "date-time"},
    "evidence_stage": {"const": "SEALED_LOCKED_EVALUATION"},
    "interpretation": {"type": "string", "minLength": 1},
    "result_hash": {"$ref": "#/$defs/sha256"}
  }
}
