{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEALED_EVALUATION_V1 request",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dependency": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^[^/\\][^:]*$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "required": [
    "schema_version", "version", "query_id", "scope", "created_at_utc", "candidate",
    "executable_spec_hash", "dependency_hash", "dependencies", "development_result_hash",
    "sealed_interval", "engine_version", "execution_model_version", "cost_model_version",
    "primary_metric", "allowed_secondary_metrics", "robustness_profiles", "query_budget",
    "allocation", "request_hash"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "version": {"const": "SEALED_EVALUATION_V1"},
    "query_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{3,63}$"},
    "scope": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": [
        "experiment_id", "experiment_version", "terminal_classification",
        "development_result_path", "development_result_sha256"
      ],
      "properties": {
        "experiment_id": {"type": "string", "minLength": 1},
        "experiment_version": {"type": "integer", "minimum": 1},
        "terminal_classification": {"type": "string", "minLength": 1},
        "development_result_path": {"type": "string", "minLength": 1},
        "development_result_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "executable_spec_hash": {"$ref": "#/$defs/sha256"},
    "dependency_hash": {"$ref": "#/$defs/sha256"},
    "dependencies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dependency"}},
    "development_result_hash": {"$ref": "#/$defs/sha256"},
    "sealed_interval": {
      "type": "object", "additionalProperties": false,
      "required": ["dataset_id", "content_hash", "start", "end", "path"],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "content_hash": {"$ref": "#/$defs/sha256"},
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "engine_version": {"type": "string", "minLength": 1},
    "execution_model_version": {"type": "string", "minLength": 1},
    "cost_model_version": {"type": "string", "minLength": 1},
    "primary_metric": {"type": "string", "minLength": 1},
    "allowed_secondary_metrics": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "robustness_profiles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "query_budget": {
      "type": "object", "additionalProperties": false,
      "required": ["authorized_queries", "requested_queries"],
      "properties": {
        "authorized_queries": {"type": "integer", "minimum": 0},
        "requested_queries": {"const": 1}
      }
    },
    "allocation": {
      "type": "object", "additionalProperties": false,
      "required": ["allocation_id", "authority", "research_director_record"],
      "properties": {
        "allocation_id": {"type": "string", "minLength": 1},
        "authority": {"type": "string", "minLength": 1},
        "research_director_record": {"type": "string", "minLength": 1}
      }
    },
    "request_hash": {"$ref": "#/$defs/sha256"}
  }
}
