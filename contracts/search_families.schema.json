{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "families"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family_id",
          "aliases",
          "entry_event_anchors",
          "parent_family_id",
          "mechanism",
          "status",
          "failure_experiment_ids",
          "legitimate_revisit"
        ],
        "properties": {
          "family_id": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "entry_event_anchors": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "parent_family_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "mechanism": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "REFERENCE_ONLY",
              "CONTROL_ONLY",
              "FAILED_REQUIRES_EVIDENCE",
              "ACTIVE_BOUNDED_RESEARCH"
            ]
          },
          "failure_experiment_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "legitimate_revisit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
