{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {"start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}}
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","project_name","project_phase","status","product_surface","research_market","symbols","canonical_resolution","signal_timeframe","regime_timeframe","max_holding_horizon","directions","development_cutoff","development_dataset","experiments_completed","sealed_evaluations_completed","paper_trades_completed","champion_status","forward_evidence","real_money_authorized","owner_decision_required","latest_reviewed_checkpoint","latest_executor_checkpoint","next_recommended_work_package","backtest_substrate"],
  "properties": {
    "schema_version": {"const": 2},
    "project_name": {"const": "Trading Bot"},
    "project_phase": {"enum": ["BOOTSTRAP", "FOUNDATION_DATA", "BACKTEST_SUBSTRATE", "BASELINE_RESEARCH"]},
    "status": {"enum": ["IN_PROGRESS", "EXECUTOR_COMPLETE_PENDING_REVIEW", "REVIEWED"]},
    "product_surface": {"const": "LOCAL_WEB_APP"},
    "research_market": {"const": "crypto_spot"},
    "symbols": {"type": "array", "prefixItems": [{"const": "BTCUSDT"}], "minItems": 1, "maxItems": 1},
    "canonical_resolution": {"const": "1m"},
    "signal_timeframe": {"const": "1h"},
    "regime_timeframe": {"const": "4h"},
    "max_holding_horizon": {"type": "object", "additionalProperties": false, "required": ["iso8601", "minutes"], "properties": {"iso8601": {"const": "PT24H"}, "minutes": {"const": 1440}}},
    "directions": {"type": "array", "items": {"enum": ["LONG", "NO_TRADE"]}, "minItems": 2, "maxItems": 2, "uniqueItems": true},
    "development_cutoff": {"type": "string", "format": "date-time", "const": "2024-12-31T23:59:00Z"},
    "development_dataset": {"type": "object", "additionalProperties": false, "required": ["status", "manifest_id", "manifest_sha256", "content_hash", "coverage"], "properties": {"status": {"const": "VALIDATED"}, "manifest_id": {"type": "string", "minLength": 1}, "manifest_sha256": {"$ref": "#/$defs/sha256"}, "content_hash": {"$ref": "#/$defs/sha256"}, "coverage": {"$ref": "#/$defs/coverage"}}},
    "experiments_completed": {"type": "integer", "minimum": 0},
    "sealed_evaluations_completed": {"type": "integer", "minimum": 0},
    "paper_trades_completed": {"type": "integer", "minimum": 0},
    "champion_status": {"type": "string", "minLength": 1},
    "forward_evidence": {"type": "string", "minLength": 1},
    "real_money_authorized": {"type": "boolean"},
    "owner_decision_required": {"type": "boolean"},
    "latest_reviewed_checkpoint": {"type": "string", "minLength": 1},
    "latest_executor_checkpoint": {"type": "string", "minLength": 1},
    "next_recommended_work_package": {"type": "string", "minLength": 1},
    "backtest_substrate": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "engine_version", "execution_model_version", "cost_model_version", "synthetic_validation", "gap_artifact"],
      "properties": {
        "status": {"enum": ["PENDING", "VALIDATED"]},
        "engine_version": {"type": "string", "minLength": 1},
        "execution_model_version": {"type": "string", "minLength": 1},
        "cost_model_version": {"type": "string", "minLength": 1},
        "synthetic_validation": {"type": "object", "additionalProperties": false, "required": ["status", "suite_hash"], "properties": {"status": {"enum": ["PENDING", "PASS"]}, "suite_hash": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}}},
        "gap_artifact": {"type": "object", "additionalProperties": false, "required": ["id", "sha256"], "properties": {"id": {"type": ["string", "null"]}, "sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}}}
      }
    }
  }
}
