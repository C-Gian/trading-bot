{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_name",
    "project_phase",
    "status",
    "product_surface",
    "research_market",
    "symbols",
    "canonical_resolution",
    "signal_timeframe",
    "regime_timeframe",
    "max_holding_horizon",
    "directions",
    "development_cutoff",
    "development_dataset",
    "experiments_completed",
    "sealed_evaluations_completed",
    "paper_trades_completed",
    "champion_status",
    "forward_evidence",
    "real_money_authorized",
    "owner_decision_required",
    "latest_reviewed_checkpoint",
    "latest_executor_checkpoint",
    "next_recommended_work_package",
    "backtest_substrate"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        2,
        3
      ]
    },
    "project_name": {
      "const": "Trading Bot"
    },
    "project_phase": {
      "enum": [
        "BOOTSTRAP",
        "FOUNDATION_DATA",
        "BACKTEST_SUBSTRATE",
        "BASELINE_RESEARCH",
        "STRATEGY_RESEARCH"
      ]
    },
    "status": {
      "enum": [
        "IN_PROGRESS",
        "EXECUTOR_COMPLETE_PENDING_REVIEW",
        "REVIEWED"
      ]
    },
    "product_surface": {
      "const": "LOCAL_WEB_APP"
    },
    "research_market": {
      "const": "crypto_spot"
    },
    "symbols": {
      "type": "array",
      "prefixItems": [
        {
          "const": "BTCUSDT"
        }
      ],
      "minItems": 1,
      "maxItems": 1
    },
    "canonical_resolution": {
      "const": "1m"
    },
    "signal_timeframe": {
      "const": "1h"
    },
    "regime_timeframe": {
      "const": "4h"
    },
    "max_holding_horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iso8601",
        "minutes"
      ],
      "properties": {
        "iso8601": {
          "const": "PT24H"
        },
        "minutes": {
          "const": 1440
        }
      }
    },
    "directions": {
      "type": "array",
      "items": {
        "enum": [
          "LONG",
          "NO_TRADE"
        ]
      },
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    },
    "development_cutoff": {
      "type": "string",
      "format": "date-time",
      "const": "2024-12-31T23:59:00Z"
    },
    "development_dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "manifest_id",
        "manifest_sha256",
        "content_hash",
        "coverage"
      ],
      "properties": {
        "status": {
          "const": "VALIDATED"
        },
        "manifest_id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        }
      }
    },
    "experiments_completed": {
      "type": "integer",
      "minimum": 0
    },
    "sealed_evaluations_completed": {
      "type": "integer",
      "minimum": 0
    },
    "paper_trades_completed": {
      "type": "integer",
      "minimum": 0
    },
    "champion_status": {
      "type": "string",
      "minLength": 1
    },
    "forward_evidence": {
      "type": "string",
      "minLength": 1
    },
    "real_money_authorized": {
      "type": "boolean"
    },
    "owner_decision_required": {
      "type": "boolean"
    },
    "latest_reviewed_checkpoint": {
      "type": "string",
      "minLength": 1
    },
    "latest_executor_checkpoint": {
      "type": "string",
      "minLength": 1
    },
    "next_recommended_work_package": {
      "type": "string",
      "minLength": 1
    },
    "search_memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "status",
        "families_tracked"
      ],
      "properties": {
        "version": {
          "enum": [
            "SEARCH_MEMORY_V1",
            "SEARCH_MEMORY_V2"
          ]
        },
        "status": {
          "enum": [
            "PENDING",
            "VALIDATED"
          ]
        },
        "families_tracked": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "adaptive_search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_economic_hypotheses",
        "configuration_variants",
        "profile_trials",
        "numeric_parameter_variants",
        "adaptive_decisions",
        "result_dependent_forks",
        "strategy_descendants",
        "wp004_variants_reserved",
        "wp004_profiles_reserved",
        "integrity_replay_profiles",
        "diagnostic_evaluations",
        "diagnostic_execution_attempts",
        "sealed_queries",
        "wp006_variants_reserved",
        "wp006_profiles_reserved",
        "wp007_variants_reserved",
        "wp007_profiles_reserved",
        "wp008_variants_reserved",
        "wp008_profiles_reserved",
        "supervised_model_fits"
      ],
      "properties": {
        "material_economic_hypotheses": {
          "type": "integer",
          "minimum": 0
        },
        "configuration_variants": {
          "type": "integer",
          "minimum": 0
        },
        "profile_trials": {
          "type": "integer",
          "minimum": 0
        },
        "numeric_parameter_variants": {
          "type": "integer",
          "minimum": 0
        },
        "adaptive_decisions": {
          "type": "integer",
          "minimum": 0
        },
        "result_dependent_forks": {
          "type": "integer",
          "minimum": 0
        },
        "strategy_descendants": {
          "type": "integer",
          "minimum": 0
        },
        "wp004_variants_reserved": {
          "type": "integer",
          "minimum": 0
        },
        "wp004_profiles_reserved": {
          "type": "integer",
          "minimum": 0
        },
        "integrity_replay_profiles": {
          "type": "integer",
          "minimum": 0
        },
        "diagnostic_evaluations": {
          "type": "integer",
          "minimum": 0
        },
        "diagnostic_execution_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "sealed_queries": {
          "type": "integer",
          "minimum": 0
        },
        "wp006_variants_reserved": {
          "type": "integer",
          "minimum": 0
        },
        "wp006_profiles_reserved": {
          "type": "integer",
          "minimum": 0
        },
        "wp007_variants_reserved": {
          "type": "integer",
          "minimum": 0
        },
        "wp007_profiles_reserved": {
          "type": "integer",
          "minimum": 0
        },
        "wp008_variants_reserved": {
          "type": "integer",
          "minimum": 0
        },
        "wp008_profiles_reserved": {
          "type": "integer",
          "minimum": 0
        },
        "supervised_model_fits": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "order_flow_substrate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "status",
        "content_hash",
        "eligible_1h_buckets",
        "eligible_4h_buckets",
        "oracle_reconciliation"
      ],
      "properties": {
        "version": {
          "const": "BTCUSDT-SPOT-ORDERFLOW-DEV-v1"
        },
        "status": {
          "const": "VALIDATED"
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "eligible_1h_buckets": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_4h_buckets": {
          "type": "integer",
          "minimum": 0
        },
        "oracle_reconciliation": {
          "const": "PASS"
        }
      }
    },
    "wp005_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source_provenance_classification",
        "independent_reconciliation",
        "integrity_replay_profiles",
        "matched_control_classification"
      ],
      "properties": {
        "status": {
          "const": "PASS"
        },
        "source_provenance_classification": {
          "enum": [
            "SOURCE_ARCHIVE_OFF_GRID_CONFIRMED",
            "DATA_PIPELINE_DEFECT"
          ]
        },
        "independent_reconciliation": {
          "const": "PASS"
        },
        "integrity_replay_profiles": {
          "const": 12
        },
        "matched_control_classification": {
          "enum": [
            "ALIGNED_DIAGNOSTIC_WEAKENED",
            "ALIGNED_DIAGNOSTIC_SUPPORTED_BUT_INCONCLUSIVE",
            "ALIGNED_DIAGNOSTIC_UNRESOLVED"
          ]
        }
      }
    },
    "selected_family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "primary_experiment_id",
        "terminal_classification"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "primary_experiment_id": {
          "type": "string",
          "minLength": 1
        },
        "terminal_classification": {
          "enum": [
            "REJECT",
            "REJECT_COST_DOMINATED",
            "REJECT_UNSTABLE",
            "REJECT_DUPLICATE_MECHANISM",
            "INCONCLUSIVE",
            "PROMISING_DEVELOPMENT_ONLY"
          ]
        }
      }
    },
    "backtest_substrate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "engine_version",
        "execution_model_version",
        "cost_model_version",
        "synthetic_validation",
        "gap_artifact"
      ],
      "properties": {
        "status": {
          "enum": [
            "PENDING",
            "VALIDATED"
          ]
        },
        "engine_version": {
          "type": "string",
          "minLength": 1
        },
        "execution_model_version": {
          "type": "string",
          "minLength": 1
        },
        "cost_model_version": {
          "type": "string",
          "minLength": 1
        },
        "synthetic_validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "suite_hash"
          ],
          "properties": {
            "status": {
              "enum": [
                "PENDING",
                "PASS"
              ]
            },
            "suite_hash": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "gap_artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "sha256"
          ],
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "sha256": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "latest_family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "root_family",
        "primary_experiment_id",
        "novelty_classification",
        "terminal_classification"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "root_family": {
          "type": "string",
          "minLength": 1
        },
        "primary_experiment_id": {
          "type": "string",
          "minLength": 1
        },
        "novelty_classification": {
          "enum": [
            "NEW_FAMILY",
            "DESCENDANT_MECHANISM_CHANGE"
          ]
        },
        "terminal_classification": {
          "enum": [
            "REJECT",
            "REJECT_COST_DOMINATED",
            "REJECT_UNSTABLE",
            "REJECT_DUPLICATE_MECHANISM",
            "INCONCLUSIVE",
            "PROMISING_DEVELOPMENT_ONLY"
          ]
        }
      }
    },
    "artifact_storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "status",
        "trial_artifact_format",
        "historical_evidence_rewritten",
        "training_matrices_committed"
      ],
      "properties": {
        "version": {"const": "RESEARCH_ARTIFACT_STORAGE_V1"},
        "status": {"const": "VALIDATED"},
        "trial_artifact_format": {"const": "PARQUET_ZSTD"},
        "historical_evidence_rewritten": {"const": false},
        "training_matrices_committed": {"const": false}
      }
    },
    "supervised_challenger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "status",
        "target",
        "primary",
        "secondary",
        "model_fits",
        "terminal_classification",
        "leakage_audit",
        "model_reconciliation"
      ],
      "properties": {
        "version": {"const": "LINEAR_NET_R_SELECTION_V1"},
        "status": {"const": "VALIDATED"},
        "target": {"const": "ISOLATED_FIXED_PLAN_DEFAULT_NET_R_V1"},
        "primary": {"const": "LINEAR_FULL"},
        "secondary": {"const": "LINEAR_NO_FLOW"},
        "model_fits": {"const": 12},
        "terminal_classification": {
          "enum": [
            "REJECT",
            "REJECT_COST_DOMINATED",
            "REJECT_UNSTABLE",
            "INCONCLUSIVE",
            "PROMISING_DEVELOPMENT_ONLY"
          ]
        },
        "leakage_audit": {"const": "PASS"},
        "model_reconciliation": {"const": "PASS"}
      }
    },
    "exogenous_foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "status", "gdelt", "alfred", "combined_context", "asof_reconciliation", "adaptive_design"],
      "properties": {
        "contract_version": {"const": "POINT_IN_TIME_EXOGENOUS_DATA_V1"},
        "status": {"const": "VALIDATED"},
        "gdelt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "status", "manifest_sha256", "logical_sha256", "hourly_rows"],
          "properties": {
            "version": {"const": "GDELT_NEWS_CONTEXT_V1"},
            "status": {"const": "VALIDATED"},
            "manifest_sha256": {"$ref": "#/$defs/sha256"},
            "logical_sha256": {"$ref": "#/$defs/sha256"},
            "hourly_rows": {"type": "integer", "minimum": 1}
          }
        },
        "alfred": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "status", "manifest_sha256", "logical_sha256", "series"],
          "properties": {
            "version": {"const": "ALFRED_MACRO_CONTEXT_V1"},
            "status": {"const": "VALIDATED"},
            "manifest_sha256": {"$ref": "#/$defs/sha256"},
            "logical_sha256": {"$ref": "#/$defs/sha256"},
            "series": {"const": 8}
          }
        },
        "combined_context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "status", "manifest_sha256", "logical_sha256", "rows"],
          "properties": {
            "version": {"const": "EXOGENOUS_CONTEXT_V1"},
            "status": {"const": "VALIDATED"},
            "manifest_sha256": {"$ref": "#/$defs/sha256"},
            "logical_sha256": {"$ref": "#/$defs/sha256"},
            "rows": {"const": 64656}
          }
        },
        "asof_reconciliation": {"const": "PASS"},
        "adaptive_design": {"const": "THREE_OPTIONS_DOCUMENTED_NOT_EXECUTED"}
      }
    },
    "exogenous_acquisition_pause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "status",
        "pause_reason",
        "record",
        "pilot_expected_requests",
        "pilot_preserved_requests",
        "wp009_finalized"
      ],
      "properties": {
        "version": {"const": "GDELT_NEWS_CONTEXT_V1_1"},
        "status": {"const": "PARTIAL"},
        "pause_reason": {"const": "PAUSED_FOR_PRODUCT_PRIORITY"},
        "record": {"const": "research/exogenous/GDELT-NEWS-CONTEXT-V1_1-PAUSE-V1.json"},
        "pilot_expected_requests": {"type": "integer", "minimum": 1},
        "pilot_preserved_requests": {"type": "integer", "minimum": 0},
        "wp009_finalized": {"const": false}
      }
    },
    "sealed_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "status",
        "dataset_state",
        "authorized_btc_queries",
        "consumed_btc_queries",
        "isolation",
        "seal_eligible_candidates",
        "candidates_assessed"
      ],
      "properties": {
        "version": {
          "enum": [
            "SEALED_EVALUATION_V1",
            "SEALED_EVALUATION_V1_1"
          ]
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "dataset_state": {
          "const": "RESERVED_NOT_ACQUIRED"
        },
        "authorized_btc_queries": {
          "type": "integer",
          "minimum": 0
        },
        "consumed_btc_queries": {
          "type": "integer",
          "minimum": 0
        },
        "isolation": {
          "const": "APPLICATION_AND_REPOSITORY_LAYER_ONLY_NOT_OS_ENFORCED"
        },
        "seal_eligible_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "candidates_assessed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "remote_ci": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "work_packages"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "work_packages": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "head",
              "run_id",
              "evidence"
            ],
            "properties": {
              "status": {
                "enum": [
                  "SUCCESS",
                  "FAILURE",
                  "PENDING_PUSH"
                ]
              },
              "head": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "run_id": {
                "type": "integer",
                "minimum": 1
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 3
          }
        }
      },
      "then": {
        "required": [
          "search_memory",
          "adaptive_search",
          "selected_family",
          "order_flow_substrate",
          "artifact_storage",
          "supervised_challenger"
        ]
      }
    }
  ]
}
