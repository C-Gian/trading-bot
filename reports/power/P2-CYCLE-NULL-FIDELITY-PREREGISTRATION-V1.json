  "criterion_semantics": {
    "ABSOLUTE_GAP": "pass when |observed - null median| <= tolerance",
    "ABSOLUTE_GAP_OR_RETAINED_SHARE": "pass when |observed - null median| <= tolerance, or when the null median retains at least retained_share of the observed value",
    "LOG_RATIO": "pass when |ln(observed / null median)| <= ln(tolerance)",
    "RATIO_BAND": "pass when minimum <= observed / null median <= maximum",
    "RETAINED_SHARE": "pass when null median >= retained_share * observed"
  },
  "decision_rule": "NULL_FIDELITY_STATUS is PASS only when every statistic passes its criterion in every fold; otherwise REDESIGN_REQUIRED and the frozen cycle result stays unobserved.",
